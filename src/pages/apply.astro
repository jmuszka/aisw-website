---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Approach from "../components/Approach.astro";
import MailingListForm from "../components/MailingListForm.astro";
import { renderMarkdown } from "../lib/markdown";
import data from "../data/site.json";

const { join, mailingList } = data;
---

<Layout
  title="Join the AISW Fellowship | Western University"
  description="Fellowship applications open mid-September and mid-January. Join the AISW mailing list and launch a career in AI safety."
>
  <Navbar />
  <main>
    <section class="border-b border-black/10 bg-platinum">
      <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
        <div class="flex flex-col gap-10 md:flex-row md:items-start md:gap-16">
          <div class="min-w-0 flex-1">
            <h1 class="font-serif text-4xl font-bold tracking-tight text-black sm:text-5xl">
              {join.title}
            </h1>
            <p class="mt-6 font-sans text-xl font-bold leading-normal text-subheading">
              {join.subhead}
            </p>
          </div>
          <div class="w-full max-w-md shrink-0 md:max-w-sm lg:max-w-md">
            <MailingListForm />
            <p
              class="mt-6 font-sans text-md leading-normal text-black [&_a]:text-subheading [&_a]:underline [&_a]:underline-offset-2 [&_a]:transition-colors hover:[&_a]:text-amethyst"
              set:html={renderMarkdown(mailingList.contact)}
            />
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-black/10 bg-platinum">
      <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
        <h2 class="max-w-3xl font-serif text-4xl font-bold tracking-tight text-black sm:text-5xl">
          {join.stat}
        </h2>
        <p class="mt-6 max-w-2xl font-sans text-lg font-bold leading-normal text-subheading">
          {join.statSub}
        </p>
        <p class="mt-4 font-serif text-lg italic text-accent-dark">
          {join.perk}
        </p>
        <div class="mt-8 max-w-3xl space-y-6 font-sans text-lg leading-normal text-black">
          {join.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <Approach />
  </main>
  <Footer />
</Layout>
