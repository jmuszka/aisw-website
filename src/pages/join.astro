---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import data from "../data/site.json";

const { sender } = data;
---

<Layout
  title="Join | AI Safety & Governance"
  description="Join AI Safety & Governance at Western University."
>
  <Navbar />
  <main>
    <section class="border-b border-slate-200">
      <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
        <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Join AI Safety &amp; Governance
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600">
          Become a member of Western's AI Safety &amp; Governance society. Fill out
          the form below to stay up to date on our programming and events.
        </p>
        <div class="mt-10 max-w-2xl">
          <div style="text-align: left" class="sender-form-field" data-sender-form-id={sender.formId}>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
