---
import data from "../data/site.json";

const { site, navLinks } = data;
---

<header class="sticky top-0 z-50 bg-accent">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="#about" class="flex flex-col leading-tight">
      <span class="text-sm font-semibold tracking-tight text-white">
        {site.name}
      </span>
      <span class="text-xs text-white/70">{site.subtitle}</span>
    </a>
    <ul class="hidden items-center gap-8 sm:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm font-medium text-white/80 transition-colors hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
