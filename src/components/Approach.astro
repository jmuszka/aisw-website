---
import data from "../data/site.json";

const { approach } = data;
---

<section id="approach" class="scroll-mt-24 border-b border-slate-200">
  <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
    <h2 class="max-w-3xl text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      {approach.title}
    </h2>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-600">
      {approach.intro}
    </p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        approach.pillars.map((pillar) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <h3 class="text-lg font-semibold text-slate-900">{pillar.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">
              {pillar.body}
            </p>
          </div>
        ))
      }
      <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6">
        <h3 class="text-lg font-semibold text-slate-900">
          {approach.more.title}
        </h3>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          {approach.more.body}
        </p>
      </div>
    </div>
  </div>
</section>
