---
import data from "../data/site.json";
import Icon from "./Icon.astro";

const { approach } = data;
---

<section id="fellowship-content" class="scroll-mt-24 border-b border-black/10 bg-platinum">
  <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
    <h2 class="max-w-3xl font-serif text-3xl font-bold tracking-tight text-black sm:text-4xl">
      {approach.title}
    </h2>

    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        approach.pillars.map((pillar) => (
          <div class="rounded-xl border border-periwinkle/40 bg-periwinkle/20 p-6 transition-transform duration-200 hover:scale-[1.03]">
            {pillar.icon && (
              <Icon
                name={pillar.icon}
                class="mb-4 h-7 w-7 text-subheading"
              />
            )}
            <h3 class="font-sans text-lg font-bold text-black">{pillar.title}</h3>
            <p class="mt-3 font-sans text-sm leading-normal text-black">{pillar.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
