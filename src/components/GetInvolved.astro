---
import data from "../data/site.json";
import { withBase } from "../lib/assets";

const { fellowship } = data;
---

<section id="get-involved" class="scroll-mt-24 border-b border-black/10 bg-platinum">
  <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
    <h2 class="max-w-3xl font-serif text-3xl font-bold tracking-tight text-black sm:text-4xl">
      {fellowship.title}
    </h2>
    <p class="mt-6 max-w-3xl font-sans text-lg leading-normal text-black">
      {fellowship.body}
    </p>
    <a
      href={withBase("/apply")}
      class="mt-8 inline-block rounded-lg bg-accent px-6 py-3 font-sans text-sm font-bold text-white transition-colors hover:bg-accent-dark"
    >
      {fellowship.cta}
    </a>
  </div>
</section>
