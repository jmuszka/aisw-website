---
import data from "../data/site.json";
import { withBase } from "../lib/assets";

const { hero } = data;
---

<section
  id="about"
  class="relative min-h-[24rem] overflow-hidden bg-amethyst scroll-mt-24 sm:min-h-[27rem] lg:min-h-[31.5rem]"
>
  <div class="relative z-10 mx-auto max-w-6xl px-6 py-18 sm:py-24">
    <h1 class="max-w-3xl font-serif text-4xl font-bold tracking-tight text-white sm:text-5xl">
      {hero.tagline}
    </h1>
    <p class="mt-6 max-w-2xl font-sans text-lg leading-normal text-periwinkle">
      {hero.subhead}
    </p>
    <div class="mt-8">
      <a
        href={withBase("/#get-involved")}
        class="inline-block rounded-lg bg-accent px-6 py-3 font-sans text-sm font-medium text-white transition-colors hover:bg-accent-dark"
      >
        {hero.cta}
      </a>
    </div>
  </div>
  <img
    src={withBase("/hero-decorator.svg")}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute right-0 bottom-0 w-[min(16.5rem,64vw)] select-none sm:w-[min(24rem,44vw)] lg:w-[min(31.5rem,38vw)]"
  />
</section>
