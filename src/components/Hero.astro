---
import data from "../data/site.json";
import { renderMarkdown } from "../lib/markdown";

const { hero, links } = data;
---

<section id="about" class="scroll-mt-24 border-b border-slate-200">
  <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
      {hero.tagline}
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600" set:html={renderMarkdown(hero.subhead)} />
    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href={links.substack}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg bg-accent px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-accent-dark"
      >
        {hero.substackCta}
      </a>
      <a
        href="#get-involved"
        class="rounded-lg border border-slate-300 px-6 py-3 text-sm font-medium text-slate-900 transition-colors hover:bg-slate-100"
      >
        {hero.getInvolvedCta}
      </a>
    </div>
  </div>
</section>
