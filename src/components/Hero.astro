---
import { SUBSTACK_URL } from "../consts";
---

<section id="about" class="scroll-mt-24 border-b border-slate-200">
  <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
      Understanding and governing advanced AI, from every angle
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600">
      A student society bringing together technology, policy, philosophy, and
      business perspectives to study the risks of AI and how to mitigate and
      adapt to them.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href={SUBSTACK_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg bg-slate-900 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-slate-700"
      >
        Read our Substack
      </a>
      <a
        href="#get-involved"
        class="rounded-lg border border-slate-300 px-6 py-3 text-sm font-medium text-slate-900 transition-colors hover:bg-slate-100"
      >
        Get Involved
      </a>
    </div>
  </div>
</section>
