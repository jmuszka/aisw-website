---
import data from "../data/site.json";
import Headlines from "./Headlines.astro";

const { mission } = data;
---

<section id="mission" class="scroll-mt-24 border-b border-black/10 bg-platinum">
  <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="min-w-0">
        <h2 class="font-serif text-3xl font-bold tracking-tight text-black sm:text-4xl">
          {mission.subtitle}
        </h2>
        <div class="mt-6 space-y-6 font-sans text-lg leading-normal text-black">
          {
            mission.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))
          }
        </div>
      </div>
      <Headlines />
    </div>
  </div>
</section>
