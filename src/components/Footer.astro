---
import data from "../data/site.json";
import { withBase } from "../lib/assets";

const { site, navLinks, links, footer } = data;
---

<footer class="relative overflow-hidden bg-accent text-white/80">
  <div
    class="absolute inset-0 bg-cover bg-center"
    style={`background-image: url('${withBase(site.footerBackground)}')`}
    aria-hidden="true"
  ></div>
  <div class="absolute inset-0 bg-accent/80 brightness-[75%]" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-semibold text-white">{site.name}</p>
        <p class="mt-1 text-sm text-white/70">{site.subtitle}</p>
      </div>
      <nav class="flex flex-col gap-3 text-sm">
        {
          navLinks.map((link) => (
            <a href={withBase(link.href)} class="transition-colors hover:text-white">
              {link.label}
            </a>
          ))
        }
        <a
          href={links.substack}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-white"
        >
          Substack
        </a>
        <a
          href={links.slack}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-white"
        >
          Slack
        </a>
      </nav>
    </div>
    <p class="mt-12 max-w-3xl border-t border-white/20 pt-6 text-xs leading-relaxed text-white/60">
      {footer.disclaimer}
    </p>
  </div>
</footer>
