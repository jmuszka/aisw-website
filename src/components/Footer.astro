---
import { SITE_NAME, SUBTITLE, SLACK_URL, SUBSTACK_URL } from "../consts";

const links = [
  { label: "About", href: "#about" },
  { label: "Our Approach", href: "#approach" },
  { label: "Get Involved", href: "#get-involved" },
  { label: "Newsletter", href: "#newsletter" },
];
---

<footer class="border-t border-slate-200 bg-slate-900 text-slate-300">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-semibold text-white">{SITE_NAME}</p>
        <p class="mt-1 text-sm text-slate-400">{SUBTITLE}</p>
      </div>
      <nav class="flex flex-col gap-3 text-sm">
        {
          links.map((link) => (
            <a href={link.href} class="transition-colors hover:text-white">
              {link.label}
            </a>
          ))
        }
        <a
          href={SUBSTACK_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-white"
        >
          Substack
        </a>
        <a
          href={SLACK_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-white"
        >
          Slack
        </a>
      </nav>
    </div>
  </div>
</footer>
