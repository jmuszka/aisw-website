---
import data from "../data/site.json";

const { site, navLinks, links } = data;
---

<footer class="bg-accent text-white/80">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-semibold text-white">{site.name}</p>
        <p class="mt-1 text-sm text-white/70">{site.subtitle}</p>
      </div>
      <nav class="flex flex-col gap-3 text-sm">
        {
          navLinks.map((link) => (
            <a href={link.href} class="transition-colors hover:text-white">
              {link.label}
            </a>
          ))
        }
        <a
          href={links.substack}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-white"
        >
          Substack
        </a>
        <a
          href={links.slack}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-white"
        >
          Slack
        </a>
      </nav>
    </div>
  </div>
</footer>
