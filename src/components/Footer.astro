---
import data from "../data/site.json";
import { withBase } from "../lib/assets";

const { site, navLinks, links, footer } = data;
---

<footer class="relative overflow-hidden bg-amethyst text-white/80">
  <div
    class="absolute inset-0 bg-cover bg-center"
    style={`background-image: url('${withBase(site.footerBackground)}')`}
    aria-hidden="true"
  ></div>
  <div class="absolute inset-0 bg-amethyst/80 brightness-[75%]" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-serif font-bold text-white">{site.name}</p>
        <p class="mt-1 font-sans text-sm text-periwinkle">{site.subtitle}</p>
      </div>
      <nav class="flex flex-col gap-3 font-sans text-sm">
        {
          navLinks.map((link) => (
            <a href={withBase(link.href)} class="transition-colors hover:text-white">
              {link.label}
            </a>
          ))
        }
        <a
          href={links.slack}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-white"
        >
          Slack
        </a>
      </nav>
    </div>
    <p class="mt-12 max-w-3xl border-t border-white/20 pt-6 font-mono text-xs leading-normal text-white/50">
      {footer.disclaimer}
    </p>
  </div>
</footer>
