---
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;

const iconModules = import.meta.glob("/node_modules/lucide-astro/dist/*.astro");
const entry = Object.entries(iconModules).find(([path]) =>
  path.endsWith(`/${name}.astro`)
);

const Icon = entry ? (await entry[1]()).default : null;
---

{
  Icon && (
    <Icon size={size} class={className} />
  )
}
