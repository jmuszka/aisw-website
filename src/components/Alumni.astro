---
import data from "../data/site.json";
import { withBase } from "../lib/assets";

const { alumni } = data;
---

<section id="alumni" class="scroll-mt-24 border-b border-black/10 bg-platinum">
  <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
    <h2 class="max-w-3xl font-serif text-3xl font-bold tracking-tight text-black sm:text-4xl">
      {alumni.title}
    </h2>
    <p class="mt-6 max-w-3xl font-sans text-lg leading-normal text-subheading">
      {alumni.subtitle}
    </p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        alumni.people.map((person) => {
          const initials = person.name
            .split(" ")
            .filter(Boolean)
            .map((part) => part[0])
            .join("")
            .slice(0, 2)
            .toUpperCase();

          return (
            <div class="flex flex-col rounded-xl border border-periwinkle/40 bg-periwinkle/20 p-6 transition-transform duration-200 hover:scale-[1.03]">
              {person.headshot ? (
                <img
                  src={withBase(person.headshot)}
                  alt={`Headshot of ${person.name}`}
                  loading="lazy"
                  class="h-30 w-30 rounded-full border-2 border-white object-cover"
                />
              ) : (
                <div class="flex h-20 w-20 items-center justify-center rounded-full border-2 border-white bg-subheading font-sans text-lg font-bold text-white">
                  {initials}
                </div>
              )}
              <h3 class="mt-5 font-sans text-lg font-bold text-black">{person.name}</h3>
              <p class="mt-2 font-sans text-sm font-bold text-subheading">{person.atWestern}</p>
              <p class="mt-3 font-sans text-sm leading-normal text-black">{person.now}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
